<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Eduvorra – Smart Learning Platform BETA V1.0</title>

  <!-- ============================================================
       EDUVORRA – Smart Learning Platform 
       ─────────────────────────────────────────────────────────────
       HOW TO ADD A NEW LESSON (external link):
       1. Find the LESSONS object in the <script> below.
       2. Go to the correct grade and subject array.
       3. Copy this block and paste it inside the array:
            { title: "Unit X – Your Title", desc: "Short description.", link: "PASTE_YOUR_LESSON_LINK_HERE" },
       4. Replace the title, desc, and link values.
       5. Save the file. Done!

       HOW TO ADD A NEW GRADE:
       1. Copy an existing grade block in LESSONS (e.g. 'Grade 1': { ... })
       2. Rename it and update lesson entries.
       3. Add a matching grade card in the HTML (search "ADD NEW GRADE CARD HERE").
       ============================================================ -->

  <style>
    /* ─── FONTS ─────────────────────────────────────────────── */
    @import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Tajawal:wght@300;400;500;700&display=swap');

    /* ─── EDUVORRA CSS VARIABLES ─────────────────────────────── */
    :root {
      --bg:         #f0f4ff;
      --surface:    #ffffff;
      --surface2:   #e8eeff;
      --primary:    #4361ee;
      --primary-d:  #3451d1;
      --accent:     #f72585;
      --accent2:    #4cc9f0;
      --text:       #1a1a2e;
      --muted:      #6b7ea8;
      --border:     #d9e2ff;
      --radius:     18px;
      --shadow:     0 8px 32px rgba(67,97,238,.13);
      --shadow-lg:  0 20px 56px rgba(67,97,238,.22);
      --transition: .35s cubic-bezier(.4,0,.2,1);
    }

    /* ─── RESET & BASE ───────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Sora', 'Tajawal', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ─── ANIMATED BACKGROUND BLOBS ─────────────────────────── */
    .blob-wrap {
      position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
    }
    .blob {
      position: absolute; border-radius: 50%; filter: blur(80px); opacity: .35;
      animation: drift 12s ease-in-out infinite alternate;
    }
    .blob-1 { width:520px; height:520px; background:#4361ee; top:-180px; left:-160px; animation-duration:13s; }
    .blob-2 { width:400px; height:400px; background:#f72585; bottom:-100px; right:-100px; animation-duration:11s; animation-delay:-4s; }
    .blob-3 { width:300px; height:300px; background:#4cc9f0; top:40%; left:55%; animation-duration:15s; animation-delay:-7s; }
    @keyframes drift {
      from { transform: translate(0,0) scale(1); }
      to   { transform: translate(40px,30px) scale(1.08); }
    }

    /* ─── PLATFORM WRAPPER ───────────────────────────────────── */
    #platform { position: relative; z-index: 1; }

    /* ─── EDUVORRA APP CONTAINER ─────────────────────────────── */
    #eduvorra-app {
      max-width: 960px; margin: 0 auto;
      padding: 0 20px 60px;
    }

    /* ─── HEADER / LOGO ──────────────────────────────────────── */
    header {
      text-align: center;
      padding: 52px 20px 36px;
    }
    .logo-mark {
      display: inline-flex; align-items: center; gap: 10px;
      margin-bottom: 6px;
    }
    .logo-icon {
      width: 46px; height: 46px;
      background: var(--primary);
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 18px rgba(67,97,238,.45);
      font-size: 22px;
    }
    .logo-text {
      font-size: clamp(2rem, 6vw, 3rem);
      font-weight: 800;
      letter-spacing: -1px;
      background: linear-gradient(135deg, var(--primary) 0%, var(--accent2) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .logo-sub {
      font-size: .95rem; font-weight: 500;
      color: var(--muted); letter-spacing: .04em;
    }

    /* ─── BREADCRUMB ─────────────────────────────────────────── */
    .breadcrumb {
      display: flex; align-items: center; gap: 6px;
      font-size: .82rem; color: var(--muted);
      margin-bottom: 28px; flex-wrap: wrap;
    }
    .breadcrumb span { color: var(--border); }
    .breadcrumb a {
      color: var(--primary); text-decoration: none; font-weight: 600;
      cursor: pointer; transition: color var(--transition);
    }
    .breadcrumb a:hover { color: var(--accent); }

    /* ─── BACK BUTTON ────────────────────────────────────────── */
    .btn-back {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--surface); border: 2px solid var(--border);
      color: var(--primary); font-family: inherit;
      font-size: .9rem; font-weight: 600;
      padding: 10px 22px; border-radius: 50px;
      cursor: pointer; margin-bottom: 32px;
      transition: var(--transition); box-shadow: var(--shadow);
    }
    .btn-back:hover {
      background: var(--primary); color: #fff; border-color: var(--primary);
      transform: translateX(-4px);
    }

    /* ─── SECTION TITLE ──────────────────────────────────────── */
    .section-title {
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 700; color: var(--text);
      margin-bottom: 8px;
    }
    .section-desc {
      color: var(--muted); font-size: .95rem;
      margin-bottom: 36px;
    }

    /* ─── CARDS GRID ─────────────────────────────────────────── */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 22px;
    }

    /* ─── GENERIC CARD ───────────────────────────────────────── */
    .card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 26px;
      cursor: pointer;
      box-shadow: var(--shadow);
      transition: var(--transition);
      position: relative; overflow: hidden;
    }
    .card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 4px;
      border-radius: var(--radius) var(--radius) 0 0;
      background: linear-gradient(90deg, var(--primary), var(--accent2));
      transform: scaleX(0); transform-origin: left;
      transition: transform var(--transition);
    }
    .card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: var(--primary); }
    .card:hover::before { transform: scaleX(1); }

    .card-emoji {
      font-size: 2.2rem; margin-bottom: 14px;
      display: block; line-height: 1;
    }
    .card-title {
      font-size: 1.15rem; font-weight: 700;
      color: var(--text); margin-bottom: 6px;
    }
    .card-sub {
      font-size: .85rem; color: var(--muted);
      line-height: 1.55;
    }
    .card-arrow {
      position: absolute; bottom: 20px; right: 22px;
      color: var(--primary); font-size: 1.1rem; opacity: 0;
      transition: var(--transition); transform: translateX(-6px);
    }
    .card:hover .card-arrow { opacity: 1; transform: translateX(0); }

    /* ─── GRADE CARDS ────────────────────────────────────────── */
    .grade-card {
      padding: 36px 28px;
      background: linear-gradient(140deg, var(--surface) 60%, var(--surface2));
    }
    .grade-card .badge {
      display: inline-block;
      background: var(--surface2); color: var(--primary);
      font-size: .75rem; font-weight: 700;
      padding: 4px 12px; border-radius: 50px;
      margin-bottom: 14px; letter-spacing: .04em;
    }
    .grade-card .card-title { font-size: 1.3rem; }
    .grade-card .card-sub-ar {
      font-size: 1rem; font-weight: 600; color: var(--primary);
      margin-top: 4px; font-family: 'Tajawal', sans-serif;
    }

    /* ─── SUBJECT CARDS ──────────────────────────────────────── */
    .subject-card {
      display: flex; align-items: center; gap: 18px;
      padding: 22px 24px;
    }
    .subject-icon-wrap {
      width: 56px; height: 56px; border-radius: 14px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem;
    }

    /* ─── LESSON CARDS (external link style) ────────────────── */
    /*
       Each lesson renders as an <a> tag with class "lesson-card".
       It opens in a new tab via target="_blank".

       TO DUPLICATE A LESSON CARD:
         In the LESSONS data (JS below), copy any lesson object:
           { title: "...", desc: "...", link: "PASTE_YOUR_LESSON_LINK_HERE" },
         Paste it inside the correct grade/subject array and update the values.
    */
    a.lesson-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 22px 22px 22px 22px;
      text-decoration: none;
      color: inherit;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }
    a.lesson-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 4px;
      border-radius: var(--radius) var(--radius) 0 0;
      background: linear-gradient(90deg, var(--primary), var(--accent2));
      transform: scaleX(0); transform-origin: left;
      transition: transform var(--transition);
    }
    a.lesson-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: var(--primary);
    }
    a.lesson-card:hover::before { transform: scaleX(1); }
    a.lesson-card:hover .card-arrow { opacity: 1; transform: translateX(0); }

    .lesson-num {
      width: 42px; height: 42px; border-radius: 12px;
      background: var(--surface2); color: var(--primary);
      font-weight: 700; font-size: .9rem;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .lesson-info { flex: 1; min-width: 0; }
    .lesson-info .card-title { font-size: 1rem; }
    .lesson-link-badge {
      display: inline-flex; align-items: center; gap: 5px;
      margin-top: 6px;
      font-size: .72rem; font-weight: 700; letter-spacing: .04em;
      color: #fff;
      background: linear-gradient(90deg, var(--primary), var(--accent2));
      padding: 3px 10px; border-radius: 50px;
    }

    /* ─── NO-LINK PLACEHOLDER (example.com links) ───────────── */
    a.lesson-card.no-link {
      opacity: .6;
      cursor: not-allowed;
    }
    a.lesson-card.no-link:hover {
      transform: none;
      box-shadow: var(--shadow);
      border-color: var(--border);
    }
    a.lesson-card.no-link::before { display: none; }
    .no-link-badge {
      display: inline-flex; align-items: center; gap: 5px;
      margin-top: 6px;
      font-size: .72rem; font-weight: 700;
      color: var(--muted);
      background: var(--surface2);
      padding: 3px 10px; border-radius: 50px;
    }

    /* ─── EDUVORRA VIEWS (show / hide) ──────────────────────── */
    .edv-view {
      display: none;
      opacity: 0;
      transform: translateY(18px);
    }
    .edv-view.active {
      display: block;
      animation: edvFadeIn .38s ease forwards;
    }
    @keyframes edvFadeIn {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ─── STAT PILLS ─────────────────────────────────────────── */
    .stats-row {
      display: flex; justify-content: center; gap: 16px;
      margin: 28px 0 48px; flex-wrap: wrap;
    }
    .stat-pill {
      background: var(--surface); border: 1.5px solid var(--border);
      border-radius: 50px; padding: 10px 20px;
      font-size: .85rem; font-weight: 600; color: var(--muted);
      display: flex; align-items: center; gap: 7px;
      box-shadow: var(--shadow);
    }
    .stat-pill strong { color: var(--primary); }

    .hero-tagline {
      text-align: center;
      font-size: clamp(1.1rem, 3vw, 1.35rem);
      color: var(--muted); font-weight: 400;
      max-width: 520px; margin: 0 auto 12px;
      line-height: 1.6;
    }

    footer {
      text-align: center; margin-top: 60px;
      color: var(--muted); font-size: .8rem; opacity: .7;
    }

    /* ─── RESPONSIVE ─────────────────────────────────────────── */
    @media (max-width: 600px) {
      .cards-grid { grid-template-columns: 1fr; }
      header { padding: 36px 16px 28px; }
    }
  </style>
</head>
<body>

  <!-- Animated background blobs -->
  <div class="blob-wrap">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
  </div>

  <div id="platform">
    <div id="eduvorra-app">

      <!-- ── LOGO / HEADER ───────────────────────────────────── -->
      <header>
        <div class="logo-mark">
          <div class="logo-icon">🎓</div>
          <span class="logo-text">Eduvorra</span>
        </div>
        <div class="logo-sub">Smart Learning Platform &nbsp;·&nbsp; منصة التعلم الذكي</div>
      </header>

      <!-- ══════════════════════════════════════════════════════
           VIEW: HOME — Grade Selection
      ══════════════════════════════════════════════════════ -->
      <section id="view-home" class="edv-view active">
        <p class="hero-tagline">Choose your grade to start learning. High-quality lessons, anytime, anywhere.</p>
        <div class="stats-row">
          <div class="stat-pill">📚 <strong>3</strong> Grades</div>
          <div class="stat-pill">📖 <strong>1+</strong> Subjects</div>
          <div class="stat-pill">✨ Interactive Lessons</div>
        </div>
        <h2 class="section-title">Select Your Grade &nbsp; اختر صفك</h2>
        <p class="section-desc">Choose the intermediate grade that matches your level.</p>
        <div class="cards-grid">

          <!-- Grade 1 Card -->
          <div class="card grade-card" onclick="showSubjects('Grade 1','First Intermediate','اول متوسط')">
            <span class="badge">GRADE 1</span>
            <span class="card-emoji">🌱</span>
            <div class="card-title">First Intermediate</div>
            <div class="card-sub-ar">اول متوسط</div>
            <div class="card-sub">Start your intermediate journey with foundational skills.</div>
            <span class="card-arrow">→</span>
          </div>

          <!-- Grade 2 Card -->
          <div class="card grade-card" onclick="showSubjects('Grade 2','Second Intermediate','ثاني متوسط')">
            <span class="badge">GRADE 2</span>
            <span class="card-emoji">📘</span>
            <div class="card-title">Second Intermediate</div>
            <div class="card-sub-ar">ثاني متوسط</div>
            <div class="card-sub">Build on your knowledge and deepen your understanding.</div>
            <span class="card-arrow">→</span>
          </div>

          <!-- Grade 3 Card -->
          <div class="card grade-card" onclick="showSubjects('Grade 3','Third Intermediate','ثالث متوسط')">
            <span class="badge">GRADE 3</span>
            <span class="card-emoji">🚀</span>
            <div class="card-title">Third Intermediate</div>
            <div class="card-sub-ar">ثالث متوسط</div>
            <div class="card-sub">Master advanced concepts and prepare for high school.</div>
            <span class="card-arrow">→</span>
          </div>

          <!-- ADD NEW GRADE CARD HERE:
               Copy one of the grade-card blocks above, update
               the badge text, emoji, titles, and onclick values.
          -->

        </div>
      </section>

      <!-- ══════════════════════════════════════════════════════
           VIEW: SUBJECTS
      ══════════════════════════════════════════════════════ -->
      <section id="view-subjects" class="edv-view">
        <div class="breadcrumb" id="breadcrumb-subjects"></div>
        <button class="btn-back" onclick="goHome()">← Back to Grades</button>
        <h2 class="section-title" id="subjects-title">Subjects</h2>
        <p class="section-desc">Select a subject to explore its lessons.</p>
        <div class="cards-grid">

          <!-- English Subject Card -->
          <div class="card subject-card" onclick="showLessons('English')">
            <div class="subject-icon-wrap" style="background:#e8f0fe;">🇬🇧</div>
            <div>
              <div class="card-title">English</div>
              <div class="card-sub">Grammar · Vocabulary · Reading · Writing</div>
            </div>
            <span class="card-arrow">→</span>
          </div>

          <!-- ADD NEW SUBJECT HERE:
               Copy the subject-card block above, update icon, title,
               and add matching lessons in the LESSONS data below.
          -->

        </div>
      </section>

      <!-- ══════════════════════════════════════════════════════
           VIEW: LESSONS — External Link Cards
           Each card is an <a> that opens in a new tab.
      ══════════════════════════════════════════════════════ -->
      <section id="view-lessons" class="edv-view">
        <div class="breadcrumb" id="breadcrumb-lessons"></div>
        <button class="btn-back" onclick="goSubjects()">← Back to Subjects</button>
        <h2 class="section-title" id="lessons-title">Lessons</h2>
        <p class="section-desc">Click any lesson card to open it in a new tab.</p>
        <!-- Lesson cards are injected here by JavaScript -->
        <div class="cards-grid" id="lessons-container"></div>
      </section>

      <footer>© 2026 Eduvorra – Smart Learning Platform
       
        Beta V1.0 - النسخة التجريبية</footer>

    </div><!-- /#eduvorra-app -->
  </div><!-- /#platform -->

  <script>
    /* ============================================================
       EDUVORRA LESSON DATA
       ─────────────────────────────────────────────────────────────
       HOW TO ADD A LESSON:
         1. Find the correct grade and subject array below.
         2. Copy this template and paste it inside the array:
              { title: "Unit X – Title", desc: "Short description.", link: "PASTE_YOUR_LESSON_LINK_HERE" },
         3. Replace the values. Save. Done!

       HOW TO DUPLICATE A LESSON CARD:
         Copy any existing lesson object (the whole { ... } block)
         and paste it on a new line inside the same array.
         Update title, desc, and link.

       NOTE: If 'link' is still "PASTE_YOUR_LESSON_LINK_HERE" or
       contains "example.com", the card will show a "Coming Soon"
       badge and will NOT open a new tab.
    ============================================================ */
    const LESSONS = {

      // ── GRADE 1 ──────────────────────────────────────────────────
      'Grade 1': {
        'English': [
          // ↓ PASTE YOUR LESSON LINK in the "link" field below
          { title: "Unit 12 – Listen & Discuss", desc: "Name places in a town.", link: "lessons/lessons1/U12/U12L1.html.html" },
          { title: "Unit 12 – Grammar",    desc: "Can & Like + Infinitive.",  link: "lessons/lessons1/U12/U12L2.html.html" },
          { title: "Unit 12 – Listening & Conversation",          desc: "Practice using can & can't.",    link: "lessons/lessons1/U12/U12L3.html.html" },
          { title: "Unit 12 – Reading",                 desc: "Read and understand simple texts.",      link: "lessons/lessons1/U12/U12L4.html.html" },
          { title: "Unit 12 – Writing",                 desc: "Write and express opinions.",      link: "lessons/lessons1/U12/U12L5.html.html" },
          // ADD NEW LESSON HERE (Grade 1 / English) ↑
        ],
      },

      // ── GRADE 2 ──────────────────────────────────────────────────
      'Grade 2': {
        'English': [
          // ↓ PASTE YOUR LESSON LINK in the "link" field below
          { title: "Unit 11 – Reading",  desc: "Form and use the present simple correctly.", link: "lessons/lessons2/U11/U11L4.html.html" },
          { title: "Unit 11 – Writing",        desc: "Write & passive voice.",            link: "lessons/lessons2/U11/U11L5.html.html" },
          { title: "Unit 11 – Form meaning and function",     desc: "Use So...That  /  Such...That.",  link: "lessons/lessons2/U11/U11L6.html.html" },
          { title: "Unit 11 – Reading Comprehension", desc: "Practice reading short passages.",           link: "PASTE_YOUR_LESSON_LINK_HERE" },
          // ADD NEW LESSON HERE (Grade 2 / English) ↑
        ],
      },

      // ── GRADE 3 ──────────────────────────────────────────────────
      'Grade 3': {
        'English': [
          // ↓ PASTE YOUR LESSON LINK in the "link" field below
          { title: "Unit 9 – Grammar", desc: "Relative Clauses (who, that, which) & Past Progressive with when/while·", link: "lessons/lessons3/U9/U9L2.html.html" },
          { title: "Unit 9 – Conversation", desc: "Practice speaking and listening skills.", link: "lessons/lessons3/U9/U9L3.html.html" },
          { title: "Unit 9 – Reading", desc: "Read and understand simple texts.", link: "lessons/lessons3/U9/U9L4.html.html" },
          // ADD NEW LESSON HERE (Grade 3 / English) ↑
          // Template to copy:
          // { title: "Unit X – Title", desc: "Description.", link: "PASTE_YOUR_LESSON_LINK_HERE" },
        ],
      },

      // ADD NEW GRADE HERE (copy a grade block above):
      // 'Grade 4': {
      //   'English': [
      //     { title: "...", desc: "...", link: "PASTE_YOUR_LESSON_LINK_HERE" },
      //   ],
      // },

    };

    /* ─── STATE ─────────────────────────────────────────────── */
    let currentGradeKey   = '';
    let currentGradeLabel = '';
    let currentGradeAr    = '';
    let currentSubject    = '';

    /* ─── VIEW SWITCHER ─────────────────────────────────────── */
    function showEduvorraView(id) {
      document.querySelectorAll('.edv-view').forEach(v => {
        v.classList.remove('active');
        v.style.display = 'none';
      });
      const el = document.getElementById(id);
      el.style.display = 'block';
      void el.offsetWidth; // force reflow for animation
      el.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* ─── NAVIGATION ────────────────────────────────────────── */
    function goHome()     { showEduvorraView('view-home'); }
    function goSubjects() { showEduvorraView('view-subjects'); }

    function showSubjects(gradeKey, gradeLabel, gradeAr) {
      currentGradeKey   = gradeKey;
      currentGradeLabel = gradeLabel;
      currentGradeAr    = gradeAr;
      document.getElementById('subjects-title').textContent = gradeLabel + ' – ' + gradeAr;
      document.getElementById('breadcrumb-subjects').innerHTML =
        `<a onclick="goHome()">🏠 Home</a><span>›</span><strong>${gradeLabel} (${gradeAr})</strong>`;
      showEduvorraView('view-subjects');
    }

    function showLessons(subject) {
      currentSubject = subject;
      document.getElementById('lessons-title').textContent =
        subject + ' – ' + currentGradeLabel + ' (' + currentGradeAr + ')';
      document.getElementById('breadcrumb-lessons').innerHTML =
        `<a onclick="goHome()">🏠 Home</a><span>›</span>
         <a onclick="goSubjects()">${currentGradeLabel}</a><span>›</span>
         <strong>${subject}</strong>`;

      const container = document.getElementById('lessons-container');
      container.innerHTML = '';
      const lessons = (LESSONS[currentGradeKey] || {})[subject] || [];

      if (lessons.length === 0) {
        container.innerHTML = '<p style="color:var(--muted);grid-column:1/-1;padding:24px 0;">No lessons added yet. Check back soon!</p>';
        showEduvorraView('view-lessons');
        return;
      }

      lessons.forEach((lesson, i) => {
        /*
          Each lesson becomes an <a class="lesson-card"> element.
          - href  = the Netlify lesson URL from LESSONS data
          - target="_blank" opens it in a new tab

          STRUCTURE OF A LESSON CARD:
          <a href="LESSON_URL" target="_blank" class="lesson-card">
            <div class="lesson-num">01</div>
            <div class="lesson-info">
              <div class="card-title">Lesson Title</div>
              <div class="card-sub">Short description</div>
              <span class="lesson-link-badge">🔗 Open Lesson</span>
            </div>
            <span class="card-arrow">→</span>
          </a>
        */

        // Detect placeholder / missing links
        const hasRealLink = lesson.link &&
          !lesson.link.includes('PASTE_YOUR_LESSON_LINK_HERE') &&
          !lesson.link.includes('example.com');

        const card = document.createElement('a');

        if (hasRealLink) {
          // ── REAL LINK: opens in new tab ──────────────────────
          card.href   = lesson.link;
          card.target = '_blank';
          card.rel    = 'noopener noreferrer';
          card.className = 'lesson-card';
        } else {
          // ── PLACEHOLDER: card shown but not clickable ────────
          card.href      = '#';
          card.className = 'lesson-card no-link';
          card.addEventListener('click', e => e.preventDefault());
        }

        card.innerHTML = `
          <div class="lesson-num">${String(i + 1).padStart(2, '0')}</div>
          <div class="lesson-info">
            <div class="card-title">${lesson.title}</div>
            ${lesson.desc ? `<div class="card-sub">${lesson.desc}</div>` : ''}
            ${hasRealLink
              ? `<span class="lesson-link-badge">🔗 Open Lesson</span>`
              : `<span class="no-link-badge">⏳ Coming Soon</span>`}
          </div>
          <span class="card-arrow">→</span>
        `;

        container.appendChild(card);
      });

      showEduvorraView('view-lessons');
    }

  </script>
</body>
</html>
